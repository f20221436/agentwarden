# Copy to .env and set a password. .env is git-ignored. Never commit real secrets.
AW_MONGO_USER=agentwarden
AW_MONGO_PASSWORD=change-me-local-only
AW_MONGO_HOST=127.0.0.1:27017
AW_MONGO_DB=agentwarden
# Or set the full URI instead (CI does this):
# AW_MONGO_URI=mongodb://localhost:27017/?directConnection=true

AW_OLLAMA_URL=http://127.0.0.1:11434
AW_MODEL=qwen2.5:3b

# Cloud provider (any OpenAI-compatible Chat Completions API). OFF unless AW_ALLOW_CLOUD=1.
# Example: Groq. Estimated prices come from agentwarden/pricing.yaml.
AW_ALLOW_CLOUD=0
# AW_CLOUD_BASE_URL=https://api.groq.com/openai/v1
# AW_CLOUD_API_KEY=gsk_your_key_here
# AW_CLOUD_MODEL=openai/gpt-oss-120b
